{
  "expo": {
    "name": "Heimdall",
    "slug": "heimdall",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "heimdall",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.emergent.hanigpsfixf4b1b81d",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Track your dog's walks and routes",
        "NSLocationAlwaysUsageDescription": "Track your dog's location in background",
        "NSCameraUsageDescription": "Take photos of your dog",
        "NSPhotoLibraryUsageDescription": "Upload photos of your dog",
        "NSBluetoothAlwaysUsageDescription": "Connect to Heimdall vest",
        "NSBluetoothPeripheralUsageDescription": "Connect to Heimdall vest"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "versionCode": 119,
      "package": "app.emergent.hanigpsfixf4b1b81d",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN"
      ],
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/heimdall-logo.png",
          "color": "#4ABDAC"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-font",
      "./plugins/withAndroidFeatures"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "24970c84-27b3-45e9-9497-04201995da3e"
      }
    },
    "owner": "alex812020"
  }
}
